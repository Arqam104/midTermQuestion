import java.util.Arrays;
import java.util.Random;

class Dice {
    private int sides;
    private int value;
    private static final Random random = new Random();

    public Dice(int sides) {
        if (sides < 2) {
            throw new IllegalArgumentException("Dice must have at least 2 sides.");
        }
        this.sides = sides;
        this.value = 0;
    }

    public int roll() {
        this.value = random.nextInt(this.sides) + 1;
        return this.value;
    }

    public int getSides() {
        return this.sides;
    }

    public int getValue() {
        return this.value;
    }

    @Override
    public String toString() {
        return "Sides: " + this.sides + ", Value: " + this.value;
    }
}

class Player {
    private String name;
    private Dice[] dice;
    private int total;

    public Player(String name, int count, int sides) {
        if (count <= 0) {
            throw new IllegalArgumentException("Number of dice must be positive.");
        }

        this.name = name;
        this.dice = new Dice[count];
        this.total = 0;

        for (int i = 0; i < this.dice.length; i++) {
            this.dice[i] = new Dice(sides);
        }
    }

    public void roll() {
        this.total = 0;
        for (int i = 0; i < this.dice.length; i++) {
            int val = this.dice[i].roll();
            System.out.println("Die " + (i + 1) + " = " + val);
            this.total += val;
        }
    }

    public int getTotal() {
        return this.total;
    }

    public void roll(int index) {
        if (index < 0 || index >= this.dice.length) {
            throw new IllegalArgumentException("Invalid dice index.");
        }
        this.total -= this.dice[index].getValue();
        int newValue = this.dice[index].roll();
        this.total += newValue;
        System.out.println("Die " + (index + 1) + " rerolled = " + newValue);
    }

    public void cheatroll() {
        int lower = 0;
        for (int i = 1; i < this.dice.length; i++) {
            if (this.dice[i].getValue() < this.dice[lower].getValue()) {
                lower = i;
            }
        }
        this.total -= this.dice[lower].getValue();
        int newValue = this.dice[lower].roll();
        this.total += newValue;
    }

    @Override
    public String toString() {
        return Arrays.toString(this.dice) + " " + this.name + " " + this.total;
    }
}

public class Main {
    public static void main(String[] args) {
        Player player = new Player("Sara", 2, 6);
        player.roll();
        System.out.println("Initial: " + player);

        player.cheatroll();
        System.out.println("After Cheat Roll: " + player);
    }
}
